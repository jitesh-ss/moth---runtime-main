{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moth-model-artifact/5.1",
  "title": "Moth weight-free compiled model artifact 5.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model_id", "runtime", "foundation", "fields", "skills", "capability_index", "members", "artifact_hash"],
  "properties": {
    "schema": {"const": "moth-model-artifact/5.1"},
    "model_id": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "entrypoint", "packages", "package_manifest"],
      "properties": {
        "compatibility": {"const": "5.1"},
        "entrypoint": {"type": "string"},
        "packages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "package_manifest": {"type": "string"}
      }
    },
    "foundation": {"type": "object"},
    "fields": {"type": "array", "minItems": 1},
    "skills": {"type": "array", "minItems": 1},
    "capability_index": {"type": "object"},
    "members": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
