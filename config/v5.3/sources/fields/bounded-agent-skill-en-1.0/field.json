      "groups": [["record", "capture"], ["before and after", "prior and resulting"], ["digests", "hashes"], ["after verification", "once verification passes"]]
    },
    {
      "id": "STEP_INCLUDE_EVIDENCE",
      "sections": ["procedure"],
      "groups": [["include", "attach"], ["evidence record", "audit record"], ["final report", "report"]]
