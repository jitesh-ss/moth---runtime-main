      "workflow": ["AUDIT_EVIDENCE"],
      "trigger": "VERIFIED_FILE_CHANGE",
      "policies": [
        {"id": "NO_FALSE_SUCCESS", "mode": "MUST_NOT", "condition": "VERIFICATION_FAILED", "outcome": "VERIFICATION_FAILED"}
      ],
      "completion": ["EVIDENCE_RECORDED"]
