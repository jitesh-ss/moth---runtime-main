        "POLICY_PROTECTED",
        "POLICY_TARGET_UNIQUE",
        "POLICY_PRECONDITION",
        "COMPLETE_AFTER_VERIFY"
      ],
      "workflow": [
        "INSPECT_TARGET",
        "VALIDATE_SCOPE",
        "VALIDATE_CARDINALITY",
        "REPLACE_EXACT",
        "VERIFY_CHANGE",
        "REPORT_VERIFIED"
      ],
      "trigger": "TEXT_REPLACEMENT_REQUEST",
      "policies": [
        {"id": "NO_UNRELATED_CHANGES", "mode": "MUST_NOT", "condition": "MODIFICATION_OUTSIDE_SCOPE", "outcome": "SCOPE_VIOLATION"},
        {"id": "PROTECTED_REQUIRES_AUTHORITY", "mode": "ASK_FIRST", "condition": "TARGET_PROTECTED", "outcome": "PROTECTED_TARGET"},
        {"id": "MISSING_OR_AMBIGUOUS_REFUSES", "mode": "REFUSE_IF", "condition": "TARGET_MISSING_OR_AMBIGUOUS", "outcome": "TARGET_NOT_UNIQUE"},
