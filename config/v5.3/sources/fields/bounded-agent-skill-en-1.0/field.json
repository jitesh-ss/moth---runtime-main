      "sections": ["procedure"],
      "groups": [["ensure", "confirm", "check"], ["text file", "text artifact"], ["permitted workspace", "allowed workspace", "permitted scope"]]
    },
    {
      "id": "STEP_CARDINALITY",
      "sections": ["procedure"],
      "groups": [["old text", "existing value", "match"], ["exactly once", "single occurrence", "one occurrence"]]
