      "groups": [["ask", "request"], ["authorization", "approval", "permission"], ["protected", "restricted"]]
    },
    {
      "id": "POLICY_TARGET_UNIQUE",
      "sections": ["safety"],
      "groups": [["refuse", "stop"], ["missing or ambiguous", "cannot uniquely identify", "absent or non-unique"]]
    },
    {
      "id": "POLICY_PRECONDITION",
      "sections": ["safety"],
      "groups": [["refuse", "stop"], ["preconditions", "required conditions", "required condition"], ["cannot be established", "are not proven", "is not proven"]]
    },
    {
      "id": "COMPLETE_AFTER_VERIFY",
