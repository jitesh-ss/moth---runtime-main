{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moth-model-artifact/5.2",
  "title": "Moth Runtime 5.2 Safetensors model artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model_id", "runtime", "kernel_foundation", "energy_foundation", "fields", "skills", "members", "artifact_hash"],
  "properties": {
    "schema": {"const": "moth-model-artifact/5.2"},
    "model_id": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "kernel_compatibility", "entrypoint", "packages", "package_manifest"],
      "properties": {
        "compatibility": {"const": "5.2"},
        "kernel_compatibility": {"const": "5.0"},
        "entrypoint": {"type": "string"},
        "packages": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "package_manifest": {"type": "string"}
      }
    },
    "kernel_foundation": {"type": "object"},
    "energy_foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_hash", "logical_hash"],
      "properties": {
        "path": {"type": "string"},
        "file_hash": {"$ref": "#/$defs/hash"},
        "logical_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "fields": {"type": "array", "minItems": 1},
    "skills": {"type": "array", "minItems": 1},
    "members": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
