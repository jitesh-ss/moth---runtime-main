    {"id": "STEP_NATURALIZE", "sections": ["workflow"], "groups": [["every material field", "all important values"], ["natural language", "prose"], ["coherent", "coherently"]]},
    {"id": "STEP_DEDUPLICATE", "sections": ["workflow"], "groups": [["remove repetition", "eliminate redundant wording"], ["response", "answer"]]},
