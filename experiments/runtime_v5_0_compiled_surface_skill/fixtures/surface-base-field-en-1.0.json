    {"id": "POLICY_REFUSE", "sections": ["fidelity"], "groups": [["refuse", "fail closed"], ["malformed result", "invalid outcome"], ["unsupported presentation instructions", "unrecognized formatting request"]]},
    {"id": "POLICY_BIND", "sections": ["fidelity"], "groups": [["bind", "attach"], ["verified semantic result", "confirmed semantic outcome"], ["compiled policy", "compiled instructions"]]},
    {"id": "POLICY_SIZE", "sections": ["size"], "groups": [["concise", "short"], ["standard", "normal"], ["detailed", "expanded"], ["budget", "word allowance"]]},
    {"id": "COMPLETE_VERIFY", "sections": ["completion"], "groups": [["only", "only when"], ["fact coverage", "semantic coverage"], ["prose"], ["word count", "response length"]]},
    {"id": "COMPLETE_EMIT", "sections": ["completion"], "groups": [["emit", "return"], ["only", "just"], ["verified natural response", "validated prose answer"]]}
  ],
  "skill_profiles": {
