  "interpretation_rules": [
    {"id": "TRIGGER_NATURAL_SURFACE", "sections": ["description"], "groups": [["realize", "turn"], ["structured decision", "structured outcome"], ["natural prose", "fluent language"], ["response size", "presentation request"]]},
    {"id": "STEP_INSPECT_RESULT", "sections": ["workflow"], "groups": [["inspect", "examine"], ["verified semantic result", "confirmed semantic outcome"], ["before", "prior to"]]},
    {"id": "STEP_INFER_SIZE", "sections": ["workflow"], "groups": [["infer", "determine"], ["requested response size", "requested answer length"], ["standard length", "normal detail"], ["no supported signal", "no recognized cue"]]},
