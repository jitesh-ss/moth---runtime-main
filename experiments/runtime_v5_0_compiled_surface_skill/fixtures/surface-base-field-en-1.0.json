      "policies": [
        {"id": "DEFAULT_STANDARD", "mode": "DEFAULT_IF", "condition": "PRESENTATION_SIGNAL_ABSENT", "outcome": "STANDARD"},
        {"id": "MALFORMED_REFUSES", "mode": "REFUSE_IF", "condition": "SEMANTIC_RESULT_MALFORMED", "outcome": "MALFORMED_SEMANTIC_RESULT"},
        {"id": "NO_INVENTION", "mode": "MUST_NOT", "condition": "UNSUPPORTED_CLAIM_PRESENT", "outcome": "UNSUPPORTED_CLAIM"},
        {"id": "PRESERVE_FIELDS", "mode": "MUST", "condition": "MATERIAL_FIELD_MISSING", "outcome": "SEMANTIC_OMISSION"},
        {"id": "PRESERVE_HASH_BINDING", "mode": "MUST", "condition": "HASH_BINDING_INVALID", "outcome": "HASH_BINDING_INVALID"},
        {"id": "PROSE_REQUIRED", "mode": "MUST", "condition": "PROSE_INVALID", "outcome": "INVALID_PROSE"},
