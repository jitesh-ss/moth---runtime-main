    {"id": "POLICY_BIND", "sections": ["fidelity"], "groups": [["bind", "attach"], ["verified semantic result", "confirmed semantic outcome"], ["compiled policy", "compiled instructions"]]},
    {"id": "POLICY_LAYOUT", "sections": ["size"], "groups": [["compact"], ["one line"], ["readable"], ["multiline", "multiple lines"], ["indent"]]},
    {"id": "COMPLETE_VERIFY", "sections": ["completion"], "groups": [["only", "only after"], ["parsing", "decoding"], ["exact value equality", "identical data"], ["safe python syntax", "inert python tree"]]},
    {"id": "COMPLETE_EMIT", "sections": ["completion"], "groups": [["emit", "return"], ["only", "just"], ["verified json or python artifact", "validated json or python output"]]}
